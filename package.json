{
  "license": "ISC",
  "scripts": {
    "build": "arcium build",
    "test": "bash scripts/test.sh",
    "test:arcium": "RYVO_UPLOAD_CIRCUITS=1 arcium test --skip-build",
    "finalize:program": "bash scripts/finalize-program.sh",
    "format": "prettier --write \"{migrations,scripts,tests,tests-arcium}/**/*.{js,ts}\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "lint": "prettier --check \"{migrations,scripts,tests,tests-arcium}/**/*.{js,ts}\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@arcium-hq/client": "0.14.1",
    "@anchor-lang/core": "^1.0.2"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "typescript": "^5.7.3",
    "prettier": "^2.6.2"
  }
}
